{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "Model.js:594-705",
    "Model.js:890-1000"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test tests/model.test.js"
  },
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 90
  },
  "concurrency": 2
}
