#!/usr/bin/env bash
# X Files login. The ONLY code that ever writes the credentials file, and the
# only shell script this plugin ships: everything else runs inside Quickshell,
# because a stock Omarchy install has no node on the session PATH.
#
#   printf %s "$TOKEN" | x-files-login --username <your-x-handle>
#   x-files-login --username <your-x-handle>      (interactive: paste at prompt)
#   x-files-login --forget
#
# The token is read from STDIN, never from argv, so it never lands in shell
# history or a world-readable /proc/<pid>/cmdline. It reaches curl through
# `--header @-` (stdin) as well, so it is never visible to ps. Get an app-only
# bearer token and pay-per-use credits at https://console.x.com
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/x-files"
CREDS="$STATE_DIR/credentials.json"

die() { printf 'x-files-login: %s\n' "$1" >&2; exit 1; }

USERNAME=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --forget)
      rm -f "$CREDS"
      printf 'x-files-login: credentials removed\n' >&2
      exit 0
      ;;
    --username) USERNAME="${2:-}"; shift 2 ;;
    --token)
      die 'pass the token on STDIN, not --token (an argv token leaks via shell history and ps). Use: printf %s "$TOKEN" | x-files-login --username <handle>'
      ;;
    *) shift ;;
  esac
done

USERNAME="${USERNAME#@}"
[[ -n $USERNAME ]] || die 'usage: printf %s "$TOKEN" | x-files-login --username <handle>'
[[ $USERNAME =~ ^[A-Za-z0-9_]{1,15}$ ]] || die 'that does not look like an X handle'

if [[ -t 0 ]]; then
  printf 'Paste your X API bearer token, then press Enter:\n' >&2
fi
IFS= read -r TOKEN || true
TOKEN="${TOKEN//[$'\r\n']/}"
[[ -n $TOKEN ]] || die 'no token on stdin'
[[ $TOKEN =~ ^[A-Za-z0-9%_-]{20,}$ ]] || die 'that does not look like a bearer token'

# One lookup proves the token works and resolves the numeric user id. The
# Authorization header rides stdin, so the token is invisible to ps.
URL="https://api.x.com/2/users/by/username/${USERNAME}?user.fields=username,name"
RESPONSE=$(printf 'Authorization: Bearer %s\n' "$TOKEN" | curl -fsS \
  --proto '=https' --max-time 20 --max-filesize 2000000 \
  --header @- -- "$URL") || die 'lookup failed. Check the token and that your credits are active.'

USER_ID=$(printf '%s' "$RESPONSE" | jq -r '.data.id // empty')
RESOLVED=$(printf '%s' "$RESPONSE" | jq -r '.data.username // empty')
[[ -n $USER_ID ]] || die 'could not parse the user lookup response'

mkdir -p -m 700 "$STATE_DIR"
TMP=$(mktemp "$CREDS.XXXXXX")
chmod 600 "$TMP"
jq -n --arg t "$TOKEN" --arg i "$USER_ID" --arg u "${RESOLVED:-$USERNAME}" \
  '{bearerToken:$t, userId:$i, username:$u}' > "$TMP"
mv "$TMP" "$CREDS"

printf 'x-files-login: connected @%s (token ending %s). The widget picks it up within a minute.\n' \
  "${RESOLVED:-$USERNAME}" "${TOKEN: -4}" >&2
